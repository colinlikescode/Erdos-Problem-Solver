# Star Fleet - repo-root .env (copy to `.env`; never commit the real file).
#
# The desktop app reads this file (star-fleet/src/electron/main.ts), forwards
# the agent-facing subset to every VM as ~/.tabs-agent.env (agentEnv.ts), and
# the two Railway services read their own subset from Railway env vars.
# Everything is optional except where noted - features without a key degrade
# (the skill simply reports the missing key).

# ---------------------------------------------------------------------------
# LLM access for the agent (at least one of these is required)
# ---------------------------------------------------------------------------
# Tier 2 / last resort: a regular OpenAI API key (sk-...). Can also be entered
# in the app's settings UI instead.
OPENAI_REGULAR_API_KEY=
# Tier 1: the codex-broker (codex-broker-railway/). Leave blank to run on the
# OpenAI key alone.
RAILWAY_BROKER_URL=
RAILWAY_BROKER_API_KEY=

# ---------------------------------------------------------------------------
# One-click DigitalOcean VMs (optional; "Connect existing" needs no cloud key)
# WARNING: the default droplet (c-60-intel, 60 vCPU / 120 GB) bills ~$1,639/mo.
# ---------------------------------------------------------------------------
DIGITAL_OCEAN_API_KEY=

# ---------------------------------------------------------------------------
# Run saves / continues - Cloudflare R2 (optional). The R2 S3 credentials are
# derived from this API token; the bucket is `starfleet-run-saves`.
# ---------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=

# ---------------------------------------------------------------------------
# Skills on the VM (each optional; the skill errors cleanly without its key)
# ---------------------------------------------------------------------------
# cpu-burst: E2B (<=200 vCPU) and Cloudflare Containers (>200 vCPU; reuses the
# Cloudflare token above).
E2B_API_KEY=
# gpu-burst: Daytona + up to two Modal workspaces.
DAYTONA_API_KEY=
MODAL_TOKEN_ID_1=
MODAL_TOKEN_SECRET_1=
MODAL_PROFILE_1=
MODAL_TOKEN_ID_2=
MODAL_TOKEN_SECRET_2=
MODAL_PROFILE_2=
# web-search / research-search
FIRECRAWL_API_KEY=
# lean-search: the lean-search-railway service
RAILWAY_LEAN_SEARCH_URL=
RAILWAY_LEAN_SEARCH_API_KEY=
# text-operator: SMS/iMessage escalation via Sendblue. Numbers in E.164.
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=
OPERATOR_PHONE_NUMBER=
# Exported to the VM for any direct Gemini use (lean-search embeds server-side).
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Railway services (set these ON RAILWAY, not on the laptop; listed here for
# reference). Deploy tokens are only needed by whoever operates the services.
# ---------------------------------------------------------------------------
# codex-broker:   RAILWAY_BROKER_API_KEY, CODEX_MODELS, DATA_DIR (volume)
# lean-search:    RAILWAY_LEAN_SEARCH_API_KEY, GEMINI_API_KEY, RAILWAY_BROKER_URL,
#                 RAILWAY_BROKER_API_KEY, OPENAI_API_KEY, CHROMA_API_KEY,
#                 CHROMA_TENANT, CHROMA_DATABASE_2
RAILWAY_ACCOUNT_API_TOKEN=
RAILWAY_PROJECT_API_TOKEN=
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE_2=lean-search
